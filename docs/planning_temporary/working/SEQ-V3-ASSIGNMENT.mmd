sequenceDiagram
    autonumber
    actor Staff as "Branch Staff"
    participant UI as "Assignment Page\n(src/app/assignment/page.tsx)"
    participant Ctrl as "SmartFMController"
    participant ASvc as "AssignmentService"
    participant SRepo as "ShipmentRepository"
    participant Branch as "Branch"
    participant Vehicle as "Vehicle"
    participant Driver as "Driver"
    participant VRepo as "VehicleRepository"
    participant DRepo as "DriverRepository"

    rect rgb(240, 248, 255)
        note right of Staff: 1. Empty UI - Opens /assignment
        Staff->>UI: Opens assignment page
        UI->>Ctrl: getUnassignedShipments()
        Ctrl->>ASvc: findUnassignedShipments()
        ASvc->>SRepo: findByStatus(UNASSIGNED)
        SRepo-->>ASvc: Shipment[]
        ASvc-->>Ctrl: ShipmentDTO[]
        Ctrl-->>UI: List
        UI-->>Staff: Shows table: Shipment ID, Origin→Dest, Weight, Vehicle Type, "Phân công" button
    end

    rect rgb(232, 245, 233)
        note right of Staff: 2. Correct input - Select shipment, assign
        Staff->>UI: Clicks "Phân công" on SHP-001
        UI->>UI: Shows branch picker (only branches with matching vehicle type)
        Staff->>UI: Selects branch BR-HCM
        UI->>Ctrl: assignVehicleDriver(shipmentId="SHP-001", branchId="BR-HCM")
        Ctrl->>ASvc: assign(shipmentId, branchId)
        ASvc->>SRepo: findById(shipmentId)
        SRepo-->>ASvc: Shipment { weight, requiredVehicleType }
        ASvc->>VRepo: findAvailableByType(branchId, requiredVehicleType)
        VRepo-->>ASvc: Vehicle (AVAILABLE)
        alt No vehicle
            ASvc-->>Ctrl: Error "Không có xe phù hợp"
            Ctrl-->>UI: Error
            UI-->>Staff: Inline error
        else Vehicle found
            ASvc->>Vehicle: canCarry(weight, volume)
            Vehicle-->>ASvc: true
            ASvc->>DRepo: findAvailableDriver(branchId, vehicleType)
            DRepo-->>ASvc: Driver (licence valid, AVAILABLE)
            alt No driver
                ASvc-->>Ctrl: Error "Không có tài xế phù hợp"
                Ctrl-->>UI: Error
                UI-->>Staff: Inline error
            else Driver found
                ASvc->>Driver: isQualifiedFor(vehicleType)
                Driver-->>ASvc: true
                ASvc->>Vehicle: assignToShipment(shipmentId)
                ASvc->>Driver: assignToShipment(shipmentId)
                Note right of ASvc: Shipment.assign(vehicle, driver) — status → PENDING
                ASvc->>VRepo: save(vehicle)
                ASvc->>DRepo: save(driver)
                ASvc->>SRepo: save(shipment)
                ASvc-->>Ctrl: AssignmentResult { vehicleId, driverId, shipmentId }
                Ctrl-->>UI: Success
                UI-->>Staff: 5. Success - Shows assigned vehicle + driver, "Hoàn tất"
            end
        end
    end

    rect rgb(255, 243, 224)
        note right of Staff: 3. Validation - Wrong branch / no resources
        Staff->>UI: Selects branch without matching vehicle type
        UI->>Ctrl: assignVehicleDriver(shipmentId, branchId)
        Ctrl->>ASvc: assign(...)
        ASvc->>SRepo: findById(shipmentId)
        SRepo-->>ASvc: Shipment
        ASvc->>VRepo: findAvailableByType(branchId, type)
        VRepo-->>ASvc: null
        ASvc-->>Ctrl: "Không có xe phù hợp tại chi nhánh này"
        Ctrl-->>UI: Error
        UI-->>Staff: "Không có xe phù hợp khả dụng tại chi nhánh này. Vui lòng chọn chi nhánh khác."
        Staff->>UI: Changes mind, picks different branch (change of mind)
        UI->>Ctrl: assignVehicleDriver(shipmentId, newBranchId)
        Note right of Ctrl: Returns to main success flow
    end

    rect rgb(255, 235, 238)
        note right of Staff: AF1: No suitable vehicle available
        Staff->>UI: Clicks "Phân công"
        UI->>Ctrl: assignVehicleDriver(shipmentId, branchId)
        Ctrl->>ASvc: assign(...)
        ASvc->>SRepo: findById(shipmentId)
        SRepo-->>ASvc: Shipment
        ASvc->>VRepo: findAvailableByType(branchId, type)
        VRepo-->>ASvc: null (all vehicles IN_USE or MAINTENANCE)
        ASvc-->>Ctrl: "Không có xe phù hợp khả dụng"
        Ctrl-->>UI: Error
        UI-->>Staff: Error + suggestion to wait/try other branch
    end

    rect rgb(255, 235, 238)
        note right of Staff: AF2: No qualified driver available
        Staff->>UI: Clicks "Phân công" (vehicle found)
        UI->>Ctrl: assignVehicleDriver(...)
        Ctrl->>ASvc: assign(...)
        ASvc->>SRepo: findById(shipmentId)
        SRepo-->>ASvc: Shipment
        ASvc->>VRepo: findAvailableByType(branchId, type)
        VRepo-->>ASvc: Vehicle
        ASvc->>DRepo: findAvailableDriver(branchId, type)
        DRepo-->>ASvc: null (all drivers busy/licence expired)
        ASvc-->>Ctrl: "Không có tài xế phù hợp khả dụng"
        Ctrl-->>UI: Error
        UI-->>Staff: Error + can reassign later
    end