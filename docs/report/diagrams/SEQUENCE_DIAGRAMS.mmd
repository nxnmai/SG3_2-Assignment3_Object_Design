sequenceDiagram
    autonumber
    actor Customer
    actor Driver
    actor Staff as "Branch Staff"
    participant UI as "SmartFM UI (Next.js)"
    participant Ctrl as "SmartFMController"
    participant Services as "Application Services (Order/Payment/Assignment/Tracking)"
    participant Domain as "Domain Entities (Order/Invoice/Shipment/Vehicle/Driver)"
    participant Repos as "Repositories (JsonFileRepository)"

    rect rgb(240, 248, 255)
        note right of Customer: V1: Browse → Search → Place Order
        Customer->>UI: Selects offering, enters goods details
        UI->>Ctrl: placeOrder(...)
        Ctrl->>Services: OrderService.createOrder(...)
        Services->>Domain: new Order(), new Invoice(), new Shipment()
        Services->>Repos: save(Order), save(Invoice), save(Shipment)
        Services-->>Ctrl: OrderConfirmationDTO
        Ctrl-->>UI: Confirmation
    end

    rect rgb(232, 245, 233)
        note right of Customer: V2: Payment Processing
        Customer->>UI: Selects payment method (Card/Cash/BankTransfer)
        UI->>Ctrl: processPayment(...)
        Ctrl->>Services: PaymentService.pay(...)
        Services->>Domain: PaymentStrategyFactory.create(method)
        Services->>Repos: save(Payment), save(Invoice)
        Services-->>Ctrl: PaymentConfirmationDTO
        Ctrl-->>UI: Receipt
    end

    rect rgb(255, 243, 224)
        note right of Staff: V3: Assign Vehicle & Driver
        Staff->>UI: Selects unassigned shipment & branch
        UI->>Ctrl: assignVehicleDriver(...)
        Ctrl->>Services: AssignmentService.assign(...)
        Services->>Domain: Vehicle.canCarry(), Driver.isQualifiedFor()
        Services->>Repos: save(Vehicle), save(Driver), save(Shipment)
        Services-->>Ctrl: AssignmentResultDTO
        Ctrl-->>UI: Assignment Success
    end

    rect rgb(232, 245, 233)
        note right of Driver: V4: Track Shipment (Real-Time)
        Driver->>UI: Updates status (PICKED_UP / IN_TRANSIT / DELIVERED)
        UI->>Ctrl: addTrackingUpdate(...)
        Ctrl->>Services: TrackingService.addUpdate(...)
        Services->>Domain: Shipment.addTrackingUpdate(...)
        Services->>Repos: save(TrackingUpdate), save(Shipment)
        Services->>Domain: TrackingNotifier.notifyObservers(...)
        Services-->>Ctrl: UpdateConfirmation
        Ctrl-->>UI: Live timeline push update
    end